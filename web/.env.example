# Copier en .env.local (non versionné) puis renseigner :

# URL du déploiement Google Apps Script (Déployer ▸ Gérer les déploiements ▸ URL de l'application Web)
VITE_GAS_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# (Plus de jeton dans l'application : l'accès passe par la connexion par mot de passe, voir gas/Auth.gs.)

# Préfixe ajouté quand le technicien saisit seulement le numéro (« 252 » → « FI-252 »).
# Laisser vide pour désactiver.
VITE_DEFAULT_PREFIX=FI
